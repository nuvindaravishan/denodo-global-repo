CREATE OR REPLACE VIEW total_bookings FOLDER = '/3 - reports' DESCRIPTION = 'The "total_bookings" view is a detailed representation of booking records for various resorts. It includes comprehensive information about each booking, such as the booking''s unique identifier, creation timestamp, details about the resort, operator, and client, as well as specifics about the booking''s duration, room details, pricing, and status. The schema provides valuable insights into customer demographics (e.g., gender, nationality), contact details (e.g., email, phone, address), and booking-specific data like arrival/departure dates, number of guests, room category, and pricing before and after discounts. 

This view could be used for tracking and analyzing resort bookings, assessing customer demographics, managing reservation details, monitoring booking statuses (e.g., checked-in or checked-out), and evaluating financial details like discounts, pricing, and totals. It could also be beneficial for generating reports on booking trends, operator performance, and customer preferences.' 
    TAGS (address, arrival_details, booking, booking_category, client, email, mcp, reservation_details, resort, restricted, room_category, tour_operator) (
    booking_identifier (description = 'Represents a unique identifier for each booking record in the system.'),
    booking_creation_timestamp (description = 'Indicates the date and time when the booking was created.'),
    resort_title (description = 'Represents the name of the resort, providing clarity and identity within the list of accommodations. It includes values like "Grand Horizon Lodge", "Ocean Breeze Retreat", "Sunset Ridge Lodge", and "Pinewood Resort".') TAGS (resort),
    booking_category (description = 'Provides a textual description of the booking type, offering insight into the purpose or nature of each type. It includes values like "Tour Operator Booking".') TAGS (booking_category),
    operator_name (description = 'Contains the name of the tour operator. It includes values like "Caddric", "Carina", "Salaidh", and "Oona".') TAGS (tour_operator),
    client_full_name (description = 'Stores the full name of the customer. It includes values like "Willian Romero", "Wilburn Nicholson", "Prince Dickerson", and "Scot Tyler".') TAGS (client),
    client_gender (description = 'Specifies the gender of the customer. It includes values like "male", "female", "male", and "female".'),
    client_email_address (description = 'Contains the email address of the customer for communication purposes. It includes values like "willian.romero@hot...", "wnicholson@aol.com", "dickersonp87@aol...", and "tylers48@protonm...".') TAGS (email),
    client_phone_number (description = 'Holds the mobile phone number of the customer for contact purposes. It includes values like "735-702-1921", "833-646-5813", "056-654-1480", and "484-441-1381".') TAGS (restricted),
    client_residential_address (description = 'Captures the address of the customer, which may include residential or mailing details. It includes values like "1042 Walter Grov...", "691 Temple Bridge", "142 Armstrong Arc...", and "1201 Finley Place".') TAGS (address),
    expected_arrival_date (description = 'Specifies the date on which the customer is expected to arrive at the resort.') TAGS (arrival_details),
    expected_arrival_time (description = 'Indicates the time when the customer is expected to arrive at the resort.') TAGS (arrival_details),
    number_of_guests (description = 'Represents the number of people included in the booking.'),
    reservation_begin_date (description = 'Denotes the start date of the reservation period for the booking.') TAGS (reservation_details),
    reservation_finish_date (description = 'Denotes the end date of the reservation period for the booking.') TAGS (reservation_details),
    operator_contact_address (description = 'Captures the physical address or location associated with the tour operator. It includes values like "2 Forest Circle", "99 Armistice Cir...", "8 Holmberg Junct...", and "56651 Coolidge Po...".') TAGS (address),
    operator_email_address (description = 'Stores the email contact information of the tour operator. It includes values like "cparrottx@sbwire...", "cetchell0@pagesp...", "sfinlry2@nhs.uk", and "omacdowale@xinh...".') TAGS (email),
    operator_phone_contact (description = 'Records the mobile phone number for contacting the tour operator. It includes values like "210-370-4819", "489-880-3003", "380-800-1251", and "975-371-1843".') TAGS (restricted),
    booking_duration_days (description = 'Specifies the total number of days for which the reservation is made.'),
    checked_in_status (description = 'Indicates whether the customer has checked into the resort.'),
    room_price_per_night (description = 'Captures the cost per night of a room for the respective booking.'),
    expected_departure_date (description = 'Specifies the date on which the customer is expected to check out from the resort.'),
    expected_departure_time (description = 'Specifies the time when the customer is expected to check out from the resort.'),
    checked_out_status (description = 'Indicates whether the customer has checked out of the resort. It includes values like "1".'),
    room_identifier (description = 'Specifies the unique number or code assigned to each room. It includes values like "rp714", "ep795", "pu778", and "ue842".'),
    room_category (description = 'Represents the type or classification of the room, reflecting its unique features. It includes values like "Queen", "Single", "Twin", and "Double".') TAGS (room_category),
    client_national_origin (description = 'Represents the nationality of the customer, reflecting their cultural background. It includes values like "Black or African...", "French", "Mexican", and "American".'),
    pre_discount_total (description = 'Captures the total amount for the booking before any discounts are applied.') TAGS (restricted),
    discount_percentage (description = 'Specifies the discount percentage applied to the booking.') TAGS (restricted),
    post_discount_total (description = 'Indicates the total amount to be paid after applying discounts.') TAGS (restricted),
    record_creation_timestamp (description = 'Represents the timestamp when the booking record was created in the system.')
 )
 AS SELECT iv_customer_resort_bookings_details.booking_id AS booking_identifier, iv_customer_resort_bookings_details.booking_date AS booking_creation_timestamp, iv_customer_resort_bookings_details.resort_name AS resort_title, iv_customer_resort_bookings_details.booking_type AS booking_category, iv_customer_resort_bookings_details.tour_operator_name AS operator_name, iv_customer_resort_bookings_details.customer_name AS client_full_name, iv_customer_resort_bookings_details.gender AS client_gender, iv_customer_resort_bookings_details.customer_email AS client_email_address, iv_customer_resort_bookings_details.customer_mobile AS client_phone_number, iv_customer_resort_bookings_details.customer_address AS client_residential_address, iv_customer_resort_bookings_details.arrival_date AS expected_arrival_date, iv_customer_resort_bookings_details.arrival_time AS expected_arrival_time, iv_customer_resort_bookings_details.no_of_pax AS number_of_guests, iv_customer_resort_bookings_details.reservation_start_date AS reservation_begin_date, iv_customer_resort_bookings_details.reservation_end_date AS reservation_finish_date, iv_customer_resort_bookings_details.tour_operator_address AS operator_contact_address, iv_customer_resort_bookings_details.tour_operator_email AS operator_email_address, iv_customer_resort_bookings_details.tour_operator_mobile AS operator_phone_contact, iv_customer_resort_bookings_details.no_of_days AS booking_duration_days, iv_customer_resort_bookings_details.is_checked_in AS checked_in_status, iv_customer_resort_bookings_details.room_fare AS room_price_per_night, iv_customer_resort_bookings_details.departure_date AS expected_departure_date, iv_customer_resort_bookings_details.departure_time AS expected_departure_time, iv_customer_resort_bookings_details.is_checked_out AS checked_out_status, iv_customer_resort_bookings_details.room_no AS room_identifier, iv_customer_resort_bookings_details.room_type AS room_category, iv_customer_resort_bookings_details.customer_nationality AS client_national_origin, iv_customer_resort_bookings_details.amount_before_discount AS pre_discount_total, iv_customer_resort_bookings_details.percentagediscount AS discount_percentage, iv_customer_resort_bookings_details.final_amount AS post_discount_total, createddate AS record_creation_timestamp, "Booking_Status" AS "Booking_Status", "ModifiedDate" AS "ModifiedDate", "ModifiedBy" AS "ModifiedBy", "Currency_ID" AS "Currency_ID", "Tax_Amount" AS "Tax_Amount", "Special_Requests" AS "Special_Requests", "Cancellation_Reason" AS "Cancellation_Reason", "Cancelled_By" AS "Cancelled_By", "Cancelled_Date" AS "Cancelled_Date" FROM iv_customer_resort_bookings_details;

ALTER VIEW total_bookings
 LAYOUT (iv_customer_resort_bookings_details = [20, 20, 200, 200]);

