CREATE OR REPLACE VIEW customer_enquiries FOLDER = '/3 - reports' DESCRIPTION = 'The customer_enquiries view contains detailed information about customer enquiries related to resorts. Each enquiry is characterized by its unique identifier, the associated resort, details of the customer (such as name, nationality, contact information), and enquiry-specific details such as timestamps, arrival/departure dates, and enquiry status. Additionally, it includes fields indicating whether an enquiry was confirmed or denied, along with reasons for denial and any associated booking identifiers. This view could be used for resort management to track customer enquiries, analyze customer demographics and preferences, and manage the enquiry lifecycle from creation to confirmation or denial. Additionally, it could assist in improving communication with customers and linking enquiries to finalized bookings for better operational insights.' 
    TAGS (arrival_details, customer_domain, departure_details, email, mcp, nationality) (
    enquiry_identifier (description = 'Uniquely identifies each customer enquiry record, providing a distinct reference for tracking enquiries.'),
    resort_identifier (description = 'Indicates the identification of the resort associated with the customer enquiry, connecting the enquiry to a specific resort.'),
    customer_full_name (description = 'Represents the full name of the customer making the enquiry, allowing identification of the individual. It includes values like "Shepard, Mitzie", "Flynn, Kareem", "Bernard, Dominique", and "Erickson, Mirtha".') TAGS (customer_domain),
    enquiry_timestamp (description = 'Specifies the precise date and time when the customer enquiry was created, capturing temporal information about the enquiry.'),
    arrival_date (description = 'Defines the expected date of arrival for the customer at the resort, indicating when the customer plans to begin their stay.') TAGS (arrival_details),
    departure_date (description = 'Defines the expected date of departure for the customer from the resort, marking the end of their planned stay.') TAGS (departure_details),
    customer_nationality (description = 'Represents the nationality of the individual making the enquiry, offering demographic insights. It includes values like "Mexican", "Black or African Am...", "Scottish", and "English".') TAGS (nationality),
    mobile_number (description = 'Stores the mobile phone number of the individual making the enquiry, facilitating direct communication. It includes values like "113-284-6504", "071-800-4528", "577-043-4381", and "073-019-7943".') TAGS (restricted),
    email_address (description = 'Records the email address of the individual making the enquiry, ensuring electronic correspondence capability. It includes values like "shepard.m@icloud.com", "flynnk96@outlook.com", "dominique_bernard@hotmail.com", and "mirtha_ericks...".') TAGS (email),
    enquiry_confirmed (description = 'Indicates whether the customer enquiry has been confirmed, reflecting the status of the enquiry''s approval.'),
    associated_booking_id (description = 'References the unique booking identification associated with the confirmation of the enquiry, linking enquiries to finalized bookings.'),
    enquiry_denied (description = 'Indicates whether the customer enquiry was denied, providing information on unsuccessful enquiry outcomes.'),
    denial_reason_code (description = 'Represents the identification code explaining the reason for denial of the enquiry, offering insights into rejection causes.'),
    enquiry_status (description = 'Displays the current status of the customer enquiry, indicating whether it is confirmed or denied. It includes values like "Confirmed", "Denied", "Confirmed", and "Denied".'),
    formatted_enquiry_date (description = 'Provides a formatted version of the enquiry date, presenting the date in a standardized format for consistent interpretation.')
 )
 AS SELECT bv_customer_enquiry.customer_enquiry_id AS enquiry_identifier, bv_customer_enquiry.resort_id AS resort_identifier, ((bv_customer_enquiry.last_name||', ')||bv_customer_enquiry.first_name) AS customer_full_name, bv_customer_enquiry.enquiry_date AS enquiry_timestamp, bv_customer_enquiry.check_in_date AS arrival_date, bv_customer_enquiry.check_out_date AS departure_date, bv_customer_enquiry.nationality AS customer_nationality, bv_customer_enquiry.mobile AS mobile_number, bv_customer_enquiry.email AS email_address, bv_customer_enquiry.is_confirmed AS enquiry_confirmed, bv_customer_enquiry.booking_id AS associated_booking_id, bv_customer_enquiry.is_denied AS enquiry_denied, bv_customer_enquiry.denied_reason_id AS denial_reason_code, case WHEN (bv_customer_enquiry.is_confirmed = true) THEN 'Confirmed' ELSE 'Denied' END AS enquiry_status, trunc(bv_customer_enquiry.enquiry_date) AS formatted_enquiry_date FROM bv_customer_enquiry;

ALTER VIEW customer_enquiries
 LAYOUT (bv_customer_enquiry = [20, 20, 200, 200]);

