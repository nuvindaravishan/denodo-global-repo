CREATE OR REPLACE VIEW booking_details FOLDER = '/3 - reports' DESCRIPTION = 'The booking_details view represents a comprehensive dataset containing detailed information about various booking records in a resort management system. Each record encapsulates data such as booking identifiers, timestamps, resort names, booking categories, customer details (e.g., full names, genders, contacts, addresses), expected arrival and departure dates and times, reservation periods, room details (e.g., room numbers, room categories, rates), number of guests, nationality, financial details (e.g., pre-discount amount, discount percentage, final payable amount), and operator details (e.g., names, addresses, emails, contacts). Additionally, it tracks check-in and check-out statuses and includes metadata like record creation timestamps. The view provides clarity and organization to the data, offering structured insights into resort bookings. 

This dataset could be used for analyzing and managing resort booking operations, customer profiles, and reservation records. It can also aid in generating financial reports, tracking room utilization, and enhancing customer service through detailed insights into bookings and operations.' 
    TAGS (address, arrival_details, booking, booking_category, customer_domain, departure_details, email, mcp, nationality, reservation_details, resort, restricted, room_category, tour_operator) (
    booking_identifier (description = 'Represents a unique identifier for each booking record in the system.'),
    booking_timestamp (description = 'Indicates the date and time when the booking was created.'),
    resort_name (description = 'Represents the name of the resort, providing clarity and identity within the list of accommodations. It includes values like "Pinewood Resort", "Mountain Valley Lodg...", "Crystal Lake Resor...", and "Redwood Haven".') TAGS (resort),
    booking_category (description = 'Provides a textual description of the booking type, offering insight into the purpose or nature of each type. It includes values like "Tour Operator Booki..." and "Direct Booking".') TAGS (booking_category),
    operator_name (description = 'Contains the name of the tour operator. It includes values like "Carina", "Salaidh", "Maggie", and "Alphard".') TAGS (tour_operator),
    full_name (description = 'Represents the full name of the customer making the booking.') TAGS (customer_domain),
    customer_gender (description = 'Specifies the gender of the customer. It includes values like "male", "female", "male", and "female".'),
    email_address (description = 'Contains the email address of the customer for communication purposes. It includes values like "rivasj55@yahoo.com", "oconley@yahoo.com", "shepard.m@icloud...", and "whitfield.a@outl...".') TAGS (email),
    mobile_number (description = 'Holds the mobile phone number of the customer for contact purposes. It includes values like "782-528-8315", "347-021-4764", "113-284-6504", and "421-786-1408".') TAGS (restricted),
    address_details (description = 'Captures the address of the customer, which may include residential or mailing details. It includes values like "867 Gillette Boulev...", "546 Cadell Green", "1161 Lundys Pike", and "198 Jakey Turnpike".') TAGS (address),
    expected_arrival_date (description = 'Specifies the date on which the customer is expected to arrive at the resort.') TAGS (arrival_details),
    expected_arrival_time (description = 'Indicates the time when the customer is expected to arrive at the resort.') TAGS (arrival_details),
    number_of_guests (description = 'Represents the number of people included in the booking.'),
    reservation_start (description = 'Denotes the start date of the reservation period for the booking.') TAGS (reservation_details),
    reservation_end (description = 'Denotes the end date of the reservation period for the booking.') TAGS (reservation_details),
    operator_address (description = 'Captures the physical address or location associated with the tour operator. It includes values like "99 Armistice Circle", "8 Holmberg Junction", "2735 Southridge Dri...", and "171 Amoth Street".') TAGS (address),
    operator_email (description = 'Stores the email contact information of the tour operator. It includes values like "cetchell0@pagespe...", "sfinlry2@nhs.uk", "mkarolovsky3@yout...", and "asleford7@simplem...".') TAGS (email),
    operator_mobile (description = 'Records the mobile phone number for contacting the tour operator. It includes values like "489-880-3003", "380-800-1251", "538-537-8087", and "960-995-4659".') TAGS (restricted),
    total_days (description = 'Specifies the total number of days for which the reservation is made.'),
    checked_in_status (description = 'Indicates whether the customer has checked into the resort.'),
    room_rate (description = 'Represents the monetary charge for the room per night.'),
    expected_departure_date (description = 'Specifies the date on which the customer is expected to check out from the resort.') TAGS (departure_details),
    expected_departure_time (description = 'Specifies the time when the customer is expected to check out from the resort.') TAGS (departure_details),
    checked_out_status (description = 'Indicates whether the customer has checked out of the resort. It includes values like "1", "1", "1", and "1".'),
    room_number (description = 'Specifies the unique number or code assigned to each room. It includes values like "pu778", "ep460", "pp863", and "pp647".'),
    room_category (description = 'Represents the type or classification of the room, reflecting its unique features or intended use. It includes values like "King", "Penthouse", "Suite", and "Apartment".') TAGS (room_category),
    nationality (description = 'Represents the nationality of the customer, reflecting their cultural background. It includes values like "Asian Indian", "Mexican", "Black or African...", and "French".') TAGS (nationality),
    pre_discount_amount (description = 'Captures the total amount for the booking before any discounts are applied.'),
    discount_percentage (description = 'Specifies the discount percentage applied to the booking.'),
    final_amount_payable (description = 'Indicates the total amount to be paid after applying discounts.'),
    record_creation_date (description = 'Represents the timestamp when the booking record was created in the system.'),
    customer_identifier (description = 'Identifies the customer who made the booking.')
 )
 AS SELECT iv_customer_resort_bookings_details.booking_id AS booking_identifier, iv_customer_resort_bookings_details.booking_date AS booking_timestamp, iv_customer_resort_bookings_details.resort_name AS resort_name, iv_customer_resort_bookings_details.booking_type AS booking_category, iv_customer_resort_bookings_details.tour_operator_name AS operator_name, iv_customer_resort_bookings_details.customer_name AS full_name, iv_customer_resort_bookings_details.gender AS customer_gender, iv_customer_resort_bookings_details.customer_email AS email_address, iv_customer_resort_bookings_details.customer_mobile AS mobile_number, iv_customer_resort_bookings_details.customer_address AS address_details, iv_customer_resort_bookings_details.arrival_date AS expected_arrival_date, iv_customer_resort_bookings_details.arrival_time AS expected_arrival_time, iv_customer_resort_bookings_details.no_of_pax AS number_of_guests, iv_customer_resort_bookings_details.reservation_start_date AS reservation_start, iv_customer_resort_bookings_details.reservation_end_date AS reservation_end, iv_customer_resort_bookings_details.tour_operator_address AS operator_address, iv_customer_resort_bookings_details.tour_operator_email AS operator_email, iv_customer_resort_bookings_details.tour_operator_mobile AS operator_mobile, iv_customer_resort_bookings_details.no_of_days AS total_days, iv_customer_resort_bookings_details.is_checked_in AS checked_in_status, iv_customer_resort_bookings_details.room_fare AS room_rate, iv_customer_resort_bookings_details.departure_date AS expected_departure_date, iv_customer_resort_bookings_details.departure_time AS expected_departure_time, iv_customer_resort_bookings_details.is_checked_out AS checked_out_status, iv_customer_resort_bookings_details.room_no AS room_number, iv_customer_resort_bookings_details.room_type AS room_category, iv_customer_resort_bookings_details.customer_nationality AS nationality, iv_customer_resort_bookings_details.amount_before_discount AS pre_discount_amount, iv_customer_resort_bookings_details.percentagediscount AS discount_percentage, iv_customer_resort_bookings_details.final_amount AS final_amount_payable, createddate AS record_creation_date, iv_customer_resort_bookings_details.customer_id AS customer_identifier, iv_customer_resort_bookings_details.resort_id AS resort_id, "Booking_Status" AS "Booking_Status", "ModifiedDate" AS "ModifiedDate", "ModifiedBy" AS "ModifiedBy", "Currency_ID" AS "Currency_ID", "Tax_Amount" AS "Tax_Amount", "Special_Requests" AS "Special_Requests", "Cancellation_Reason" AS "Cancellation_Reason", "Cancelled_By" AS "Cancelled_By", "Cancelled_Date" AS "Cancelled_Date" FROM iv_customer_resort_bookings_details;

ALTER VIEW booking_details
 LAYOUT (iv_customer_resort_bookings_details = [20, 20, 200, 200]);

