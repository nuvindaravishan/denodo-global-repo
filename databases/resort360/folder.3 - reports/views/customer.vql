CREATE OR REPLACE VIEW customer FOLDER = '/3 - reports' DESCRIPTION = 'Customer view represents a comprehensive dataset containing detailed information about individual customers. It includes fields such as unique identifiers, personal details, demographic data, contact information, and additional attributes. The schema encompasses fields like customer_identifier (unique ID for each customer), customer_first_name and customer_last_name (providing personalized identification), full_customer_name (a concatenated name format), date_of_birth (demographic insight), customer_gender (segmentation and diversity analysis), customer_email_address and customer_mobile_number (contact details), customer_nationality (cultural or geographic background), customer_address (location specifics), passport_number (legal identification), passenger_count (family or group size), state_identifier (regional tracking), and record_creation_date (traceability and auditability). Real data examples are present in fields like names ("Malone, Sachiko"), genders ("male" and "female"), and email addresses, enriching the dataset further. The view includes an association with the customer_booking view, establishing a link between customer data and booking records. This view could be used for customer profile creation, personalized marketing, demographic analysis, communication management, and linking customer data to booking records for travel or related services.' 
    PRIMARY KEY ( 'customer_identifier' )
    TAGS (address, customer_domain, email, mcp, nationality, restricted) (
    customer_identifier (description = 'Represents a unique identifier assigned to each customer, ensuring individual distinction within the system.'),
    customer_first_name (description = 'Contains the first name of the customer, enabling personalization and identification within records. It includes values like "Sachiko", "Janett", "Alleen", and "Tad".') TAGS (customer_domain),
    customer_last_name (description = 'Stores the last name of the customer, supporting detailed record creation and referencing. It includes values like "Malone", "Zamora", "Whitfield", and "Justice".') TAGS (customer_domain),
    full_customer_name (description = 'Combines both first and last names of the customer into a complete name format for consistency. It includes values like "Malone, Sachiko", "Zamora, Janett", "Whitfield, Alleen", and "Justice, Tad".') TAGS (customer_domain),
    date_of_birth (description = 'Indicates the date of birth of the customer, providing insights into their age and demographic attributes.'),
    customer_gender (description = 'Specifies the gender of the customer, supporting segmentation and diversity analysis. It includes values like "male", "female", "male", and "female".'),
    customer_email_address (description = 'Contains the email address of the customer, facilitating communication and notifications. It includes values like "sachiko.malone@icl...", "janett_zamora@aol...", "whitfield.a@outlo...", and "justicet84@gmail.c...".') TAGS (email),
    customer_nationality (description = 'Represents the nationality of the customer, reflecting cultural and geographic backgrounds. It includes values like "French", "Mexican", "Black or African...", and "American".') TAGS (nationality),
    customer_mobile_number (description = 'Holds the mobile phone number of the customer, enabling direct contact and communication. It includes values like "456-758-1579", "231-902-3875", "421-786-1408", and "001-395-2362".') TAGS (restricted),
    customer_address (description = 'Captures the address of the customer, supporting delivery and location-specific services. It includes values like "824 Sagamore Grove", "307 Oshaughnessy C...", "198 Jakey Turnpike", and "144 Highland Green".') TAGS (address),
    passport_number (description = 'Contains the passport number of the customer for identification and legal compliance. It includes values like "18pu8148946814", "91ee1770609483", "41eu0017214879", and "75up8897428865".') TAGS (restricted),
    state_identifier (description = 'Represents a code identifying the state associated with the customer, aiding in regional tracking. It includes values like "5", "33", "9", and "43".'),
    record_creation_date (description = 'Records the date and time when the customer record was created in the system, ensuring traceability and auditability.')
 )
 AS SELECT bv_customer.customer_id AS customer_identifier, bv_customer.first_name AS customer_first_name, bv_customer.last_name AS customer_last_name, ((bv_customer.last_name||', ')||bv_customer.first_name) AS full_customer_name, bv_customer.dob AS date_of_birth, bv_customer.gender AS customer_gender, bv_customer.email AS customer_email_address, bv_customer.nationality AS customer_nationality, bv_customer.mobile AS customer_mobile_number, bv_customer.address AS customer_address, bv_customer.passportno AS passport_number, bv_customer.state_id AS state_identifier, createddate AS record_creation_date FROM bv_customer;

ALTER VIEW customer
 LAYOUT (bv_customer = [20, 20, 200, 200]);

