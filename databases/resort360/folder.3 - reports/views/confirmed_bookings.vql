CREATE OR REPLACE VIEW confirmed_bookings FOLDER = '/3 - reports' DESCRIPTION = 'The confirmed_bookings view represents detailed records of customer bookings and enquiries for various resorts. It contains information such as enquiry identifiers, timestamps, resort titles, customer full names, arrival and departure dates, customer nationalities, mobile numbers, email addresses, reservation identifiers, confirmation statuses, confirmation dates, and record creation timestamps. This data is organized to provide comprehensive tracking and management of booking logistics, personalized customer information, and demographic insights. The confirmed_bookings view could be used for managing and analyzing customer booking data, tracking confirmation statuses, facilitating communication with customers, and gaining demographic insights about resort visitors. It may also assist in generating timelines of confirmed bookings and understanding customer preferences based on booking patterns.' 
    TAGS (arrival_details, booking, customer_domain, departure_details, mcp, nationality, resort, restricted) (
    enquiry_identifier (description = 'Uniquely identifies each customer enquiry record for tracking and reference.'),
    enquiry_timestamp (description = 'Specifies the precise date and time a customer enquiry was made, aiding in chronological records.'),
    resort_title (description = 'Represents the name of the resort, providing clarity and identity within the list of accommodations. It includes values like "Mountain Valley Lodge", "Pinewood Resort", "Crystal Lake Resort", and "Blue Sky Escape".') TAGS (resort),
    customer_full_name (description = 'Captures the full name of the customer making the enquiry, ensuring personalized service. It includes values like "Marvella Robinson", "Tad Justice", "Dominique Bernard", and "Felisa Boyer".') TAGS (customer_domain),
    arrival_date (description = 'Defines the expected date of arrival for the customer at the resort, facilitating booking logistics.') TAGS (arrival_details),
    departure_date (description = 'Defines the expected date of departure for the customer from the resort, ensuring accurate scheduling.') TAGS (departure_details),
    customer_nationality (description = 'Represents the nationality of the individual making the enquiry, contributing to demographic insights. It includes values like "Black or African...", "Mexican", "Scottish", and "English".') TAGS (nationality),
    mobile_number (description = 'Stores the mobile phone number of the individual making the enquiry for communication purposes. It includes values like "128-200-8772", "001-395-2362", "577-043-4381", and "701-755-9927".') TAGS (restricted),
    email_address (description = 'Records the email address of the individual making the enquiry for correspondence. It includes values like "robinsonm27@protonmail.com", "justicet84@gmail.com", "dominique_bernard@hotmail.com", and "boyer.f@yahoo.com".') TAGS (email),
    reservation_identifier (description = 'References the unique booking identification associated with the confirmation of the enquiry.'),
    confirmation_status (description = 'Indicates whether the customer enquiry has been confirmed, reflecting the booking status.'),
    confirmation_date (description = 'Specifies the date on which the customer enquiry was confirmed, enabling timeline tracking.'),
    record_creation_timestamp (description = 'Indicates the creation timestamp of the customer enquiry record, ensuring accurate data management.')
 )
 AS SELECT iv_confirmed_bookings.customer_enquiry_id AS enquiry_identifier, iv_confirmed_bookings.enquiry_date AS enquiry_timestamp, iv_confirmed_bookings.resort_name AS resort_title, iv_confirmed_bookings.customer_name AS customer_full_name, iv_confirmed_bookings.check_in_date AS arrival_date, iv_confirmed_bookings.check_out_date AS departure_date, iv_confirmed_bookings.nationality AS customer_nationality, iv_confirmed_bookings.mobile AS mobile_number, iv_confirmed_bookings.email AS email_address, iv_confirmed_bookings.booking_id AS reservation_identifier, iv_confirmed_bookings.is_confirmed AS confirmation_status, iv_confirmed_bookings.confirmed_on AS confirmation_date, createddate AS record_creation_timestamp FROM iv_confirmed_bookings;

ALTER VIEW confirmed_bookings
 LAYOUT (iv_confirmed_bookings = [20, 20, 200, 200]);

