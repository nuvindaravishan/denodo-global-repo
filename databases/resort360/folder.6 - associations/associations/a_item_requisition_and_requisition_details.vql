FOLDER = '/6 - associations'
    ENDPOINT bv_item_requisition_details bv_item_requisition PRINCIPAL (1)
    ENDPOINT bv_item_requisition bv_item_requisition_details (0,*)
    ADD MAPPING ir_id=ir_id;

ALTER ASSOCIATION a_item_requisition_and_requisition_details
 LAYOUT (bv_item_requisition = [141, 150, 200, 200], bv_item_requisition_details = [399, 35, 200, 200]);

