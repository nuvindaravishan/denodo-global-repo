CREATE OR REPLACE ASSOCIATION a_customer_booking_resorts_with_states REFERENTIAL CONSTRAINT 
FOLDER = '/6 - associations'
    ENDPOINT resorts customer_booking (0,*)
    ENDPOINT booking resorts_with_states PRINCIPAL (1)
    ADD MAPPING resort_identifier=resort_id;

ALTER ASSOCIATION a_customer_booking_resorts_with_states
 LAYOUT (customer_booking = [136, 65, 200, 200], resorts_with_states = [480, 58, 200, 200]);

