# REQUIRES-PROPERTIES-FILE - # Do not remove this comment!
CREATE OR REPLACE WRAPPER JDBC bv_booking
    FOLDER = '/1 - dataconnection/2 - base views'
    DATASOURCENAME=ds_sql_resort360db
    CATALOGNAME='${databases.resort360.folder.1 - dataconnection.folder.2 - base views.views.jdbc.bv_booking.CATALOGNAME}' 
    SCHEMANAME='${databases.resort360.folder.1 - dataconnection.folder.2 - base views.views.jdbc.bv_booking.SCHEMANAME}' 
    RELATIONNAME='Booking' 
    OUTPUTSCHEMA (
        booking_id = 'Booking_ID' :'java.lang.Long' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='19', sourcetypeid='-5', sourcetypename='bigint identity')  NOT NULL SORTABLE IS_AUTOINCREMENT,
        resort_id = 'Resort_ID' :'java.lang.Long' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='19', sourcetypeid='-5', sourcetypename='bigint')  NOT NULL SORTABLE,
        booking_date = 'Booking_Date' :'java.time.LocalDateTime' (OPT) (sourcetypedecimals='3', sourcetypesize='23', sourcetypeid='93', sourcetypename='datetime')  NOT NULL SORTABLE,
        booking_type_id = 'Booking_Type_ID' :'java.lang.Long' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='19', sourcetypeid='-5', sourcetypename='bigint')  NOT NULL SORTABLE,
        tour_operator_id = 'Tour_Operator_ID' :'java.lang.Long' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='19', sourcetypeid='-5', sourcetypename='bigint')  SORTABLE,
        tour_operator_contract_id = 'Tour_Operator_Contract_ID' :'java.lang.Long' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='19', sourcetypeid='-5', sourcetypename='bigint')  SORTABLE,
        customer_id = 'Customer_ID' :'java.lang.Long' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='19', sourcetypeid='-5', sourcetypename='bigint')  NOT NULL SORTABLE,
        arrival_date = 'Arrival_Date' :'java.time.LocalDate' (OPT) (sourcetypedecimals='0', sourcetypesize='10', sourcetypeid='91', sourcetypename='date')  NOT NULL SORTABLE,
        arrival_time = 'Arrival_Time' :'java.time.LocalTime' (OPT) (sourcetypedecimals='7', sourcetypesize='16', sourcetypeid='92', sourcetypename='time')  SORTABLE,
        no_of_pax = 'No_of_Pax' :'java.lang.Long' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='19', sourcetypeid='-5', sourcetypename='bigint')  NOT NULL SORTABLE,
        reservation_start_date = 'Reservation_Start_Date' :'java.time.LocalDate' (OPT) (sourcetypedecimals='0', sourcetypesize='10', sourcetypeid='91', sourcetypename='date')  NOT NULL SORTABLE,
        reservation_end_date = 'Reservation_End_Date' :'java.time.LocalDate' (OPT) (sourcetypedecimals='0', sourcetypesize='10', sourcetypeid='91', sourcetypename='date')  NOT NULL SORTABLE,
        no_of_days = 'No_Of_Days' :'java.lang.Long' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='19', sourcetypeid='-5', sourcetypename='bigint')  NOT NULL SORTABLE,
        is_checked_in = 'Is_Checked_in' :'java.lang.Boolean' (OPT) (sourcetypesize='1', sourcetypeid='-7', sourcetypename='bit')  NOT NULL SORTABLE,
        room_master_id = 'Room_Master_ID' :'java.lang.Long' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='19', sourcetypeid='-5', sourcetypename='bigint')  SORTABLE,
        room_fare = 'Room_Fare' :'java.math.BigDecimal' (OPT) (sourcetypedecimals='4', sourcetyperadix='10', sourcetypesize='19', sourcetypeid='3', sourcetypename='money')  NOT NULL NOT SORTABLE,
        amount_before_discount = 'Amount_Before_Discount' :'java.math.BigDecimal' (OPT) (sourcetypedecimals='4', sourcetyperadix='10', sourcetypesize='19', sourcetypeid='3', sourcetypename='money')  NOT NULL NOT SORTABLE,
        percentagediscount = 'PercentageDiscount' :'java.math.BigDecimal' (OPT) (sourcetypedecimals='2', sourcetyperadix='10', sourcetypesize='5', sourcetypeid='3', sourcetypename='decimal')  SORTABLE,
        final_amount = 'Final_Amount' :'java.math.BigDecimal' (OPT) (sourcetypedecimals='4', sourcetyperadix='10', sourcetypesize='19', sourcetypeid='3', sourcetypename='money')  NOT NULL NOT SORTABLE,
        departure_date = 'Departure_Date' :'java.time.LocalDate' (OPT) (sourcetypedecimals='0', sourcetypesize='10', sourcetypeid='91', sourcetypename='date')  SORTABLE,
        departure_time = 'Departure_Time' :'java.time.LocalTime' (OPT) (sourcetypedecimals='7', sourcetypesize='16', sourcetypeid='92', sourcetypename='time')  SORTABLE,
        is_checked_out = 'Is_Checked_Out' :'java.lang.Boolean' (OPT) (sourcetypesize='1', sourcetypeid='-7', sourcetypename='bit')  NOT NULL SORTABLE,
        customer_enquiry_id = 'Customer_Enquiry_Id' :'java.lang.Long' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='19', sourcetypeid='-5', sourcetypename='bigint')  SORTABLE,
        "Booking_Status" = 'Booking_Status' :'java.lang.String' (OPT) (sourcetypesize='20', sourcetypeid='12', sourcetypename='varchar')  SORTABLE,
        createddate = 'CreatedDate' :'java.time.LocalDateTime' (OPT) (sourcetypedecimals='3', sourcetypesize='23', sourcetypeid='93', sourcetypename='datetime')  NOT NULL SORTABLE,
        "ModifiedDate" = 'ModifiedDate' :'java.time.LocalDateTime' (OPT) (sourcetypedecimals='7', sourcetypesize='27', sourcetypeid='93', sourcetypename='datetime2')  SORTABLE,
        "ModifiedBy" = 'ModifiedBy' :'java.lang.Long' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='19', sourcetypeid='-5', sourcetypename='bigint')  SORTABLE,
        "Currency_ID" = 'Currency_ID' :'java.lang.Long' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='19', sourcetypeid='-5', sourcetypename='bigint')  SORTABLE,
        "Tax_Amount" = 'Tax_Amount' :'java.math.BigDecimal' (OPT) (sourcetypedecimals='4', sourcetyperadix='10', sourcetypesize='19', sourcetypeid='3', sourcetypename='money')  NOT SORTABLE,
        "Special_Requests" = 'Special_Requests' :'java.lang.String' (OPT) (sourcetypesize='2147483647', sourcetypeid='-9', sourcetypename='nvarchar')  SORTABLE,
        "Cancellation_Reason" = 'Cancellation_Reason' :'java.lang.String' (OPT) (sourcetypesize='500', sourcetypeid='-9', sourcetypename='nvarchar')  SORTABLE,
        "Cancelled_By" = 'Cancelled_By' :'java.lang.Long' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='19', sourcetypeid='-5', sourcetypename='bigint')  SORTABLE,
        "Cancelled_Date" = 'Cancelled_Date' :'java.time.LocalDateTime' (OPT) (sourcetypedecimals='7', sourcetypesize='27', sourcetypeid='93', sourcetypename='datetime2')  SORTABLE
    )
    CONSTRAINT 'PK_Booking' PRIMARY KEY ( 'Booking_ID' )
    CONSTRAINT 'FK_Booking_Type' FOREIGN KEY ( 'Booking_Type_ID' ) 
    REFERENCES 'resort360'.'dbo'.'Booking_Type'( 'Booking_Type_ID' )  ON UPDATE NO ACTION  ON DELETE NO ACTION NOT DEFERRABLE 
    CONSTRAINT 'FK_Booking_Currency' FOREIGN KEY ( 'Currency_ID' ) 
    REFERENCES 'resort360'.'dbo'.'Currency'( 'Currency_ID' )  ON UPDATE NO ACTION  ON DELETE NO ACTION NOT DEFERRABLE 
    CONSTRAINT 'FK_Booking_Customer' FOREIGN KEY ( 'Customer_ID' ) 
    REFERENCES 'resort360'.'dbo'.'Customer'( 'Customer_ID' )  ON UPDATE NO ACTION  ON DELETE NO ACTION NOT DEFERRABLE 
    CONSTRAINT 'FK_Booking_Customer_Enquiry' FOREIGN KEY ( 'Customer_Enquiry_Id' ) 
    REFERENCES 'resort360'.'dbo'.'Customer_Enquiry'( 'Customer_Enquiry_Id' )  ON UPDATE NO ACTION  ON DELETE NO ACTION NOT DEFERRABLE 
    CONSTRAINT 'FK_Booking_Resort' FOREIGN KEY ( 'Resort_ID' ) 
    REFERENCES 'resort360'.'dbo'.'Resort'( 'Resort_ID' )  ON UPDATE NO ACTION  ON DELETE NO ACTION NOT DEFERRABLE 
    CONSTRAINT 'FK_Booking_Room_Master' FOREIGN KEY ( 'Room_Master_ID' ) 
    REFERENCES 'resort360'.'dbo'.'Room_Master'( 'Room_Master_ID' )  ON UPDATE NO ACTION  ON DELETE NO ACTION NOT DEFERRABLE 
    CONSTRAINT 'FK_Booking_Tour_Operator' FOREIGN KEY ( 'Tour_Operator_ID' ) 
    REFERENCES 'resort360'.'dbo'.'Tour_Operator'( 'Tour_Operator_ID' )  ON UPDATE NO ACTION  ON DELETE NO ACTION NOT DEFERRABLE 
    CONSTRAINT 'FK_Booking_Tour_Operator_Contract' FOREIGN KEY ( 'Tour_Operator_Contract_ID' ) 
    REFERENCES 'resort360'.'dbo'.'Tour_Operator_Contract'( 'Tour_Operator_Contract_ID' )  ON UPDATE NO ACTION  ON DELETE NO ACTION NOT DEFERRABLE 
    CONSTRAINT 'FK_Booking_CancelledBy' FOREIGN KEY ( 'Cancelled_By' ) 
    REFERENCES 'resort360'.'dbo'.'Users'( 'User_ID' )  ON UPDATE NO ACTION  ON DELETE NO ACTION NOT DEFERRABLE 
    CONSTRAINT 'FK_Booking_ModifiedBy' FOREIGN KEY ( 'ModifiedBy' ) 
    REFERENCES 'resort360'.'dbo'.'Users'( 'User_ID' )  ON UPDATE NO ACTION  ON DELETE NO ACTION NOT DEFERRABLE 
    INDEX 'PK_Booking' CLUSTER UNIQUE PRIMARY ( 'Booking_ID' )
    INDEX 'IX_Booking_Customer' OTHER ( 'Customer_ID' )
    INDEX 'IX_Booking_Modified' OTHER ( 'ModifiedDate' )
    INDEX 'IX_Booking_Resort_Date' OTHER ( 'Resort_ID' , 'Reservation_Start_Date' , 'Reservation_End_Date' )
    INDEX 'IX_Booking_Room' OTHER ( 'Room_Master_ID' )
    INDEX 'IX_Booking_Status' OTHER ( 'Booking_Status' );

CREATE OR REPLACE TABLE bv_booking I18N us_est (
        booking_id:long (notnull, autoincrement, sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19', description = 'Represents a unique identifier for each booking record in the system.') TAGS (booking),
        resort_id:long (notnull, sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19', description = 'Denotes the identifier of the resort associated with the booking.') TAGS (resort),
        booking_date:timestamp (notnull, sourcetypeid = '93', sourcetypedecimals = '3', sourcetypesize = '23', description = 'Indicates the date and time when the booking was created.') TAGS (booking_date),
        booking_type_id:long (notnull, sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19', description = 'Refers to the type or category of the booking.'),
        tour_operator_id:long (sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19', description = 'Specifies the unique identifier of the tour operator associated with the booking.'),
        tour_operator_contract_id:long (sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19', description = 'Captures the identifier of the contract between the tour operator and the resort for the booking.'),
        customer_id:long (notnull, sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19', description = 'Identifies the customer who made the booking.') TAGS (customer_domain),
        arrival_date:localdate (notnull, sourcetypeid = '91', sourcetypedecimals = '0', sourcetypesize = '10', description = 'Specifies the date on which the customer is expected to arrive at the resort.') TAGS (check_in_list),
        arrival_time:time (sourcetypeid = '92', sourcetypedecimals = '7', sourcetypesize = '16', description = 'Indicates the time when the customer is expected to arrive at the resort.'),
        no_of_pax:long (notnull, sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19', description = 'Represents the number of people included in the booking.'),
        reservation_start_date:localdate (notnull, sourcetypeid = '91', sourcetypedecimals = '0', sourcetypesize = '10', description = 'Denotes the start date of the reservation period for the booking.'),
        reservation_end_date:localdate (notnull, sourcetypeid = '91', sourcetypedecimals = '0', sourcetypesize = '10', description = 'Denotes the end date of the reservation period for the booking.'),
        no_of_days:long (notnull, sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19', description = 'Specifies the total number of days for which the reservation is made.'),
        is_checked_in:boolean (notnull, sourcetypeid = '-7', sourcetypesize = '1', description = 'Indicates whether the customer has checked into the resort.'),
        room_master_id:long (sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19', description = 'Refers to the identifier of the room assigned for the booking.'),
        room_fare:decimal (notnull, sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '4', sourcetypesize = '19', description = 'Represents the cost of the room per booking.'),
        amount_before_discount:decimal (notnull, sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '4', sourcetypesize = '19', description = 'Captures the total amount for the booking before any discounts are applied.') TAGS (sales),
        percentagediscount:decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '2', sourcetypesize = '5', description = 'Specifies the discount percentage applied to the booking.'),
        final_amount:decimal (notnull, sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '4', sourcetypesize = '19', description = 'Indicates the total amount to be paid after applying discounts.') TAGS (sales),
        departure_date:localdate (sourcetypeid = '91', sourcetypedecimals = '0', sourcetypesize = '10', description = 'Specifies the date on which the customer is expected to check out from the resort.'),
        departure_time:time (sourcetypeid = '92', sourcetypedecimals = '7', sourcetypesize = '16', description = 'Specifies the time when the customer is expected to check out from the resort.'),
        is_checked_out:boolean (notnull, sourcetypeid = '-7', sourcetypesize = '1', description = 'Indicates whether the customer has checked out of the resort. It includes values like "1", "1", "1", and "1".'),
        customer_enquiry_id:long (sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19', description = 'Refers to the identifier of the customer enquiry related to the booking.'),
        "Booking_Status":text (sourcetypeid = '12', sourcetypesize = '20'),
        createddate:timestamp (notnull, sourcetypeid = '93', sourcetypedecimals = '3', sourcetypesize = '23', description = 'Represents the timestamp when the booking record was created in the system.'),
        "ModifiedDate":timestamp (sourcetypeid = '93', sourcetypedecimals = '7', sourcetypesize = '27'),
        "ModifiedBy":long (sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19'),
        "Currency_ID":long (sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19'),
        "Tax_Amount":decimal (sourcetypeid = '3', sourcetyperadix = '10', sourcetypedecimals = '4', sourcetypesize = '19'),
        "Special_Requests":text (sourcetypeid = '-9', sourcetypesize = '2147483647'),
        "Cancellation_Reason":text (sourcetypeid = '-9', sourcetypesize = '500'),
        "Cancelled_By":long (sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19'),
        "Cancelled_Date":timestamp (sourcetypeid = '93', sourcetypedecimals = '7', sourcetypesize = '27')
    )
    FOLDER = '/1 - dataconnection/2 - base views'
    CONSTRAINT 'PK_Booking' PRIMARY KEY ( 'booking_id' , 'resort_id' )
    TAGS (booking, booking_date, check_in_list, customer_domain, reservation_details, resort, sales)
    CACHE OFF
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD bv_booking(
        I18N us_est
        CONSTRAINTS (
             ADD booking_id (any) OPT ANY
             ADD resort_id (any) OPT ANY
             ADD booking_date (any) OPT ANY
             ADD booking_type_id (any) OPT ANY
             ADD tour_operator_id (any) OPT ANY
             ADD tour_operator_contract_id (any) OPT ANY
             ADD customer_id (any) OPT ANY
             ADD arrival_date (any) OPT ANY
             ADD arrival_time (any) OPT ANY
             ADD no_of_pax (any) OPT ANY
             ADD reservation_start_date (any) OPT ANY
             ADD reservation_end_date (any) OPT ANY
             ADD no_of_days (any) OPT ANY
             ADD is_checked_in (any) OPT ANY
             ADD room_master_id (any) OPT ANY
             ADD room_fare (any) OPT ANY
             ADD amount_before_discount (any) OPT ANY
             ADD percentagediscount (any) OPT ANY
             ADD final_amount (any) OPT ANY
             ADD departure_date (any) OPT ANY
             ADD departure_time (any) OPT ANY
             ADD is_checked_out (any) OPT ANY
             ADD customer_enquiry_id (any) OPT ANY
             ADD "Booking_Status" (any) OPT ANY
             ADD createddate (any) OPT ANY
             ADD "ModifiedDate" (any) OPT ANY
             ADD "ModifiedBy" (any) OPT ANY
             ADD "Currency_ID" (any) OPT ANY
             ADD "Tax_Amount" (any) OPT ANY
             ADD "Special_Requests" (any) OPT ANY
             ADD "Cancellation_Reason" (any) OPT ANY
             ADD "Cancelled_By" (any) OPT ANY
             ADD "Cancelled_Date" (any) OPT ANY
        )
        OUTPUTLIST ("Booking_Status", "Cancellation_Reason", "Cancelled_By", "Cancelled_Date", "Currency_ID", "ModifiedBy", "ModifiedDate", "Special_Requests", "Tax_Amount", amount_before_discount, arrival_date, arrival_time, booking_date, booking_id, booking_type_id, createddate, customer_enquiry_id, customer_id, departure_date, departure_time, final_amount, is_checked_in, is_checked_out, no_of_days, no_of_pax, percentagediscount, reservation_end_date, reservation_start_date, resort_id, room_fare, room_master_id, tour_operator_contract_id, tour_operator_id
        )
        WRAPPER (jdbc bv_booking)
    );

