CREATE OR REPLACE VIEW iv_booking_test FOLDER = '/1 - dataconnection/2 - base views' AS SELECT bv_booking.booking_id AS booking_id, bv_booking.booking_date AS booking_date, bv_booking.booking_type_id AS booking_type_id, bv_booking.tour_operator_id AS tour_operator_id, bv_booking.tour_operator_contract_id AS tour_operator_contract_id, bv_booking.customer_id AS customer_id, bv_booking.arrival_date AS arrival_date, bv_booking.arrival_time AS arrival_time, bv_booking.no_of_pax AS no_of_pax, bv_booking.reservation_start_date AS reservation_start_date, bv_booking.reservation_end_date AS reservation_end_date, bv_booking.no_of_days AS no_of_days, bv_booking.is_checked_in AS is_checked_in, bv_booking.room_master_id AS room_master_id, bv_booking.room_fare AS room_fare, bv_booking.amount_before_discount AS amount_before_discount, bv_booking.percentagediscount AS percentagediscount, bv_booking.final_amount AS final_amount, bv_booking.departure_date AS departure_date, bv_booking.departure_time AS departure_time, bv_booking.is_checked_out AS is_checked_out, bv_booking.customer_enquiry_id AS customer_enquiry_id, bv_booking."Booking_Status" AS "Booking_Status", bv_booking.createddate AS createddate, bv_booking."Currency_ID" AS "Currency_ID", bv_booking."Tax_Amount" AS "Tax_Amount", bv_booking."Special_Requests" AS "Special_Requests", bv_booking."Cancellation_Reason" AS "Cancellation_Reason", bv_booking."Cancelled_By" AS "Cancelled_By", bv_booking."Cancelled_Date" AS "Cancelled_Date", bv_resorts.resort_id AS resort_id, bv_resorts.resort_name AS resort_name, bv_resorts.resort_type AS resort_type, bv_resorts.state_id AS state_id, bv_resorts.address AS address, bv_resorts.city AS city, bv_resorts.phone AS phone, bv_resorts.email AS email, bv_resorts.star_rating AS star_rating, bv_resorts.description AS description, bv_resorts.amenities AS amenities, bv_resorts.check_in_time AS check_in_time, bv_resorts.check_out_time AS check_out_time, bv_resorts.default_currency_id AS default_currency_id, bv_resorts.timezone AS timezone, bv_resorts.is_active AS is_active, bv_resorts.created_date AS created_date, bv_resorts.modifieddate AS modifieddate, bv_resorts.modifiedby AS modifiedby FROM bv_booking AS bv_booking INNER JOIN bv_resorts AS bv_resorts ON bv_booking.resort_id = bv_resorts.resort_id ;

ALTER VIEW iv_booking_test
 LAYOUT (bv_booking = [20, 19, 200, 200], bv_resorts = [267, 147, 200, 200]);

