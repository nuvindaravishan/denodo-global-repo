CREATE OR REPLACE VIEW dp_revenue_optimization FOLDER = '/4 - data products' (
    "Resort name" (description = 'Represents the name of the resort, providing clarity and identity within the list of accommodations.'),
    "Booking count" (description = 'Specifies the total number of bookings for the respective resort or room category.'),
    "Booking revenue" (description = 'Represents the total revenue generated from bookings for the respective resort or room category.'),
    "Avg booking value" (description = 'Indicates the average revenue generated per booking for the respective resort or room category.'),
    "Avg stay duration" (description = 'Reflects the average duration of stays (in days) for bookings in the respective resort or room category.'),
    "Total room count" (description = 'Specifies the total number of rooms available within the resort.'),
    "Occupied rooms" (description = 'Indicates the number of rooms currently occupied within the resort.'),
    "Vacant rooms" (description = 'Represents the number of rooms available and unoccupied within the resort.'),
    "Room occupancy rate" (description = 'Shows the proportion of occupied rooms relative to the total room count, expressed as a percentage or rate.'),
    "Total amenity revenue" (description = 'Represents the total revenue generated from amenities provided by the resort.'),
    "Total resort revenue" (description = 'Indicates the overall revenue generated by the resort from all sources.'),
    "Revenue per available room" (description = 'Calculates the average revenue generated per available room within the resort.'),
    "Revenue per occupied room" (description = 'Determines the average revenue generated per occupied room in the resort.'),
    "Pricing signal" (description = 'Indicates pricing trends or strategies for the respective resort or room category.')
 )
 AS
    SELECT rrr.resort_name AS "Resort name",
           rrr.booking_count AS "Booking count",
           round(rrr.booking_revenue,2) AS "Booking revenue",
           round(rrr.avg_booking_value,2) AS "Avg booking value",
           round(rrr.avg_stay_duration,2) AS "Avg stay duration",
           cor.total_room_count AS "Total room count",
           cor.occupied_rooms AS "Occupied rooms",
           cor.vacant_rooms AS "Vacant rooms",
           round(cor.room_occupancy_rate,2) AS "Room occupancy rate",
           round(coalesce(sum(ars.total_amenity_revenue), 0),2) AS "Total amenity revenue",
           round((rrr.booking_revenue + coalesce(sum(ars.total_amenity_revenue), 0)),2) AS "Total resort revenue",
           round(CASE WHEN (cor.total_room_count > 0) THEN
               (rrr.booking_revenue / cor.total_room_count)
           ELSE
               0
           END,2) AS "Revenue per available room",
           CASE WHEN (cor.occupied_rooms > 0) THEN
               (rrr.booking_revenue / cor.occupied_rooms)
           ELSE
               0
           END AS "Revenue per occupied room",
           CASE WHEN ((cor.room_occupancy_rate >= 0.90 AND rrr.avg_booking_value >= 10000)) THEN
               'PREMIUM_PRICE_OPPORTUNITY'
           WHEN (cor.room_occupancy_rate >= 0.80) THEN
               'PRICE_INCREASE_OPPORTUNITY'
           WHEN (cor.room_occupancy_rate < 0.50) THEN
               'PROMOTION_REQUIRED'
           ELSE
               'STABLE_PRICING'
           END AS "Pricing signal"
    FROM (
             iv_dp_revenue_by_resort_room AS rrr
             LEFT OUTER JOIN current_occupancy_rate AS cor
                 ON rrr.resort_id = cor.resort_identifier
         )
         LEFT OUTER JOIN iv_dp_amenity_revenue_summary AS ars
             ON rrr.resort_name = ars.resort_name
    GROUP BY rrr.resort_name,
             rrr.booking_count,
             rrr.booking_revenue,
             rrr.avg_booking_value,
             rrr.avg_stay_duration,
             cor.total_room_count,
             cor.occupied_rooms,
             cor.vacant_rooms,
             cor.room_occupancy_rate CONTEXT ('formatted' = 'yes');

ALTER VIEW dp_revenue_optimization
 LAYOUT (iv_dp_revenue_by_resort_room = [0, 0, 200, 200], current_occupancy_rate = [0, 200, 200, 200], iv_dp_amenity_revenue_summary = [0, 400, 200, 200]);

