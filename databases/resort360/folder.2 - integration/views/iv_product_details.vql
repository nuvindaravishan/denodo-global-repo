CREATE OR REPLACE VIEW iv_product_details FOLDER = '/2 - integration' DESCRIPTION = 'The iv_product_details view contains detailed information about various products, including their unique identifiers, codes, names, sub-category and category names, descriptions, measurement units, prices, quantities, reorder levels, active status, and additional details. Each field is designed to provide a comprehensive understanding of the product''s attributes, making it easier to organize, categorize, and analyze the data. The iv_product_details view could be used for managing product inventories, tracking stock levels, analyzing sales or pricing patterns, categorizing products by type and sub-category, and ensuring smooth operations for businesses dealing with physical or virtual goods. Additionally, it can aid in reordering processes, identifying active products, and maintaining a detailed catalog of items within a system.'  (
    quantity TAGS (item_quantity)
 )
 AS SELECT bv_product.item_id AS item_id, bv_product.item_code AS item_code, bv_product.item_name AS item_name, bv_product_sub_category.product_sub_category_name AS product_sub_category_name, bv_product_sub_category.product_category_name AS product_category_name, bv_product.description AS description, bv_product.unit AS unit, bv_product.price AS price, bv_product.quantity AS quantity, bv_product.reorder_level AS reorder_level, bv_product.is_active AS is_active, bv_product.other_details AS other_details FROM bv_product AS bv_product INNER JOIN bv_product_sub_category AS bv_product_sub_category ON bv_product.item_sub_category_id = bv_product_sub_category.product_sub_category_id ;

ALTER VIEW iv_product_details
 LAYOUT (bv_product = [92, 86, 200, 200], bv_product_sub_category = [409, 86, 200, 200]);

