CREATE OR REPLACE VIEW iv_tour_operator_bookings FOLDER = '/2 - integration' DESCRIPTION = 'The iv_tour_operator_bookings view represents essential information related to tour operators and their booking activities. It consists of fields such as the name of the tour operator, their mobile contact number, email address, the total number of bookings they manage, and the revenue generated from these bookings. Each field provides specific insights into operational scale, financial performance, and communication details of the tour operators. This view could be used for analyzing tour operator performance, monitoring booking trends, identifying key operators based on revenue and bookings, and facilitating communication with operators for business purposes or collaboration opportunities.'  (
    tour_operator_name (description = 'Represents the name of the tour operator, crucial for identifying and associating bookings with specific operators. It includes values like "Armin", "Armin" and "Armin".') TAGS (tour_operator),
    tour_operator_mobile (description = 'Records the mobile phone contact of the tour operator, facilitating direct communication. It includes values like "992-817-1391", "992-817-1391" and "992-817-1391".') TAGS (restricted),
    tour_operator_email (description = 'Stores the email address of the tour operator, serving as a primary communication channel for professional correspondence. It includes values like "ahollindalel@fc2...", "ahollindalel@fc2..." and "ahollindalel@fc2...".') TAGS (email),
    total_bookings (description = 'Indicates the total number of bookings managed by a tour operator, reflecting operational scale and activity.'),
    revenue (description = 'Represents the monetary earnings generated from bookings, providing insights into financial performance.') TAGS (sales)
 )
 AS SELECT iv_customer_resort_bookings_details.tour_operator_name AS tour_operator_name, iv_customer_resort_bookings_details.tour_operator_mobile AS tour_operator_mobile, iv_customer_resort_bookings_details.tour_operator_email AS tour_operator_email, count(*) AS total_bookings, sum(iv_customer_resort_bookings_details.final_amount) AS revenue, iv_customer_resort_bookings_details."Booking_Status" AS "Booking_Status", iv_customer_resort_bookings_details."ModifiedDate" AS "ModifiedDate", iv_customer_resort_bookings_details."ModifiedBy" AS "ModifiedBy", iv_customer_resort_bookings_details."Currency_ID" AS "Currency_ID", iv_customer_resort_bookings_details."Tax_Amount" AS "Tax_Amount", iv_customer_resort_bookings_details."Special_Requests" AS "Special_Requests", iv_customer_resort_bookings_details."Cancellation_Reason" AS "Cancellation_Reason", iv_customer_resort_bookings_details."Cancelled_By" AS "Cancelled_By", iv_customer_resort_bookings_details."Cancelled_Date" AS "Cancelled_Date" FROM iv_customer_resort_bookings_details WHERE booking_type = 'Tour Operator' GROUP BY iv_customer_resort_bookings_details.tour_operator_mobile, iv_customer_resort_bookings_details.tour_operator_email, iv_customer_resort_bookings_details.tour_operator_name, iv_customer_resort_bookings_details.createddate, iv_customer_resort_bookings_details.createddate, iv_customer_resort_bookings_details."Booking_Status", iv_customer_resort_bookings_details."ModifiedDate", iv_customer_resort_bookings_details."ModifiedBy", iv_customer_resort_bookings_details."Currency_ID", iv_customer_resort_bookings_details."Tax_Amount", iv_customer_resort_bookings_details."Special_Requests", iv_customer_resort_bookings_details."Cancellation_Reason", iv_customer_resort_bookings_details."Cancelled_By", iv_customer_resort_bookings_details."Cancelled_Date";

ALTER VIEW iv_tour_operator_bookings
 LAYOUT (iv_customer_resort_bookings_details = [20, 20, 200, 200]);

