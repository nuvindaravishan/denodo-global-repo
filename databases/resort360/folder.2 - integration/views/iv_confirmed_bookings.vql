CREATE OR REPLACE VIEW iv_confirmed_bookings FOLDER = '/2 - integration' DESCRIPTION = 'The iv_confirmed_bookings view contains detailed information about confirmed customer bookings at various resorts. It includes fields that uniquely identify customer enquiries, such as customer_enquiry_id, as well as specific details like the enquiry date, resort name, customer name, and contact information (including mobile and email). The view also specifies the check-in and check-out dates, the customer’s nationality, and the booking confirmation status, along with a unique booking ID, the date of confirmation, and the record creation timestamp. Examples of resort names include "Pinewood Resort," "Mountain Valley Lodge," and "Crystal Lake Resort." Additionally, nationality examples include "Russian," "Polish," and "Mexican," while mobile and email fields store sample individual contact details. This view could be used to manage and analyze confirmed bookings at resorts, including tracking customer details, reservation dates, and confirmation status. It can assist in generating booking reports, monitoring booking trends, and facilitating customer support related to enquiries and confirmed bookings.' 
    PRIMARY KEY ( 'customer_enquiry_id' )
    TAGS (booking) (
    customer_name (sourcetypesize = '30', sourcetypeid = '12') TAGS (customer_domain),
    resort_name TAGS (resort),
    nationality TAGS (nationality),
    mobile TAGS (restricted),
    email TAGS (email)
 )
 AS SELECT bv_customer_enquiry.customer_enquiry_id AS customer_enquiry_id, bv_customer_enquiry.enquiry_date AS enquiry_date, bv_resorts.resort_name AS resort_name, concat(bv_customer_enquiry.first_name, ' ', bv_customer_enquiry.last_name) AS customer_name, bv_customer_enquiry.check_in_date AS check_in_date, bv_customer_enquiry.check_out_date AS check_out_date, bv_customer_enquiry.nationality AS nationality, bv_customer_enquiry.mobile AS mobile, bv_customer_enquiry.email AS email, bv_customer_enquiry.booking_id AS booking_id, bv_customer_enquiry.is_confirmed AS is_confirmed, bv_customer_enquiry.confirmed_on AS confirmed_on, bv_customer_enquiry.createddate AS createddate FROM bv_customer_enquiry AS bv_customer_enquiry INNER JOIN bv_resorts AS bv_resorts ON bv_customer_enquiry.resort_id = bv_resorts.resort_id  WHERE bv_customer_enquiry.is_confirmed = true;

ALTER VIEW iv_confirmed_bookings
 LAYOUT (bv_customer_enquiry = [186, 68, 200, 200], bv_resorts = [467, 76, 200, 200]);

