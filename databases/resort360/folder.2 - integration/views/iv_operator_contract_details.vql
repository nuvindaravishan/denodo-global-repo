CREATE OR REPLACE VIEW iv_operator_contract_details FOLDER = '/2 - integration'
    PRIMARY KEY ( 'tour_operator_contract_id' ) (
    email TAGS (email),
    mobile TAGS (restricted),
    resort_name TAGS (resort),
    tour_operator_name TAGS (tour_operator),
    contact_address TAGS (address)
 )
 AS SELECT bv_tour_operator_contract.tour_operator_contract_id AS tour_operator_contract_id, bv_tour_operator_contract.tour_operator_id AS tour_operator_id, bv_tour_operator_contract.contract_start_date AS contract_start_date, bv_resorts.resort_name AS resort_name, bv_tour_operator_contract.contract_end_date AS contract_end_date, bv_tour_operator_contract.all_inclusive AS all_inclusive, bv_tour_operator_contract.discount AS discount, bv_tour_operators.name AS tour_operator_name, bv_tour_operators.state AS state, bv_tour_operators.contact_address AS contact_address, bv_tour_operators.email AS email, bv_tour_operators.mobile AS mobile, bv_tour_operators.registration_details AS registration_details FROM (bv_tour_operator_contract AS bv_tour_operator_contract INNER JOIN bv_tour_operators AS bv_tour_operators ON bv_tour_operator_contract.tour_operator_id = bv_tour_operators.tour_operator_id ) INNER JOIN bv_resorts AS bv_resorts ON bv_tour_operator_contract.resort_id = bv_resorts.resort_id ;

ALTER VIEW iv_operator_contract_details
 LAYOUT (bv_tour_operator_contract = [113, 66, 200, 200], bv_tour_operators = [425, 61, 200, 200], bv_resorts = [706, 60, 200, 200]);

