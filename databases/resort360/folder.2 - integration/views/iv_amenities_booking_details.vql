CREATE OR REPLACE VIEW iv_amenities_booking_details FOLDER = '/2 - integration' DESCRIPTION = 'The view named iv_amenities_booking_details contains detailed information about bookings of various amenities offered at resorts. The schema includes fields such as booking_id, amenities_name, amenities_booking_date, resort_name, customer_name, customer_mobile, booking_time, slot_booked, no_of_hours, rate, cost, and createddate. These fields capture essential details including the unique identifiers for bookings, names of amenities and resorts involved, customer contact information, booking date and time, reserved time slots, duration of the bookings, costs associated, and timestamps for record creation. Example data includes "Helicopter Tour" and "Golf" as amenities, "Pinewood Resort" and "Mountain Valley Lodge" as resorts, and specific booking times like "20:45" or "07:04." Such metadata helps to maintain accurate and organized records of amenities-related bookings. The view iv_amenities_booking_details could be used for tracking and managing bookings of resort amenities by maintaining detailed records of transactions. It would be instrumental in financial assessment, scheduling, resource allocation, customer management, and generating reports about amenities usage and bookings. Additionally, it could help resorts analyze preferences and trends in bookings, ensuring effective operational planning and customer satisfaction.'  (
    resort_name TAGS (resort),
    customer_name TAGS (customer_domain),
    customer_mobile TAGS (restricted)
 )
 AS SELECT bv_customer_amenities_booking.booking_id AS booking_id, bv_customer_amenities_booking.booking_date AS amenities_booking_date, iv_customer_resort_bookings_details.resort_name AS resort_name, iv_customer_resort_bookings_details.customer_name AS customer_name, iv_customer_resort_bookings_details.customer_mobile AS customer_mobile, bv_customer_amenities_booking.booking_time AS booking_time, bv_customer_amenities_booking.slot_booked AS slot_booked, bv_customer_amenities_booking.no_of_hours AS no_of_hours, bv_amenities.rate AS rate, (bv_amenities.rate*bv_customer_amenities_booking.no_of_hours) AS cost, iv_customer_resort_bookings_details.createddate AS createddate, bv_amenities.amenity_name AS amenity_name, iv_customer_resort_bookings_details."Booking_Status" AS "Booking_Status", iv_customer_resort_bookings_details."ModifiedDate" AS "ModifiedDate", iv_customer_resort_bookings_details."ModifiedBy" AS "ModifiedBy", iv_customer_resort_bookings_details."Currency_ID" AS "Currency_ID", iv_customer_resort_bookings_details."Tax_Amount" AS "Tax_Amount", iv_customer_resort_bookings_details."Special_Requests" AS "Special_Requests", iv_customer_resort_bookings_details."Cancellation_Reason" AS "Cancellation_Reason", iv_customer_resort_bookings_details."Cancelled_By" AS "Cancelled_By", iv_customer_resort_bookings_details."Cancelled_Date" AS "Cancelled_Date" FROM (bv_customer_amenities_booking AS bv_customer_amenities_booking INNER JOIN bv_amenities AS bv_amenities ON cast(bv_customer_amenities_booking.amenities_id AS INTEGER) = bv_amenities.amenity_id ) INNER JOIN iv_customer_resort_bookings_details AS iv_customer_resort_bookings_details ON bv_customer_amenities_booking.booking_id = iv_customer_resort_bookings_details.booking_id ;

ALTER VIEW iv_amenities_booking_details
 LAYOUT (bv_customer_amenities_booking = [85, 77, 200, 200], bv_amenities = [373, 94, 200, 200], iv_customer_resort_bookings_details = [250, 215, 200, 200]);

