CREATE OR REPLACE VIEW iv_room_category_revenue FOLDER = '/2 - integration' DESCRIPTION = 'The `iv_room_category_revenue` view contains detailed information about resorts, room types, and their associated revenue. It includes fields such as the identifier and name of the resort (`resort_id` and `resort_name`), the type or classification of rooms (`room_type`), the total revenue generated from bookings (`revenue`), and the timestamp when the booking record was created (`createddate`). This view provides structured insights related to resorts and their financial performance based on room categories. This view could be used for analyzing revenue trends, comparing financial performance across resorts or room categories, and generating reports for decision-making in the hospitality industry. It is valuable for financial analysis, operational planning, and strategic decision-making.'  (
    resort_id (description = 'Denotes the identifier of the resort associated with the booking, uniquely distinguishing each resort.'),
    resort_name (description = 'Represents the name of the resort, providing clarity and identity within the list of accommodations. It includes values like "Pinewood Resort", "Pinewood Resort", "Pinewood Resort", and "Pinewood Resort".') TAGS (resort),
    room_type (description = 'Represents the type or classification of the room, reflecting its unique features or intended use. It includes values like "Villa", "Villa", "Villa", and "Villa".') TAGS (room_category),
    revenue (description = 'Represents the total revenue generated from bookings, providing key financial insights.') TAGS (sales),
    createddate (description = 'Represents the timestamp when the booking record was created in the system, indicating when the entry was recorded.')
 )
 AS SELECT resort_id AS resort_id, resort_name AS resort_name, room_type AS room_type, sum(final_amount) AS revenue, createddate AS createddate, "Booking_Status" AS "Booking_Status", "ModifiedDate" AS "ModifiedDate", "ModifiedBy" AS "ModifiedBy", "Currency_ID" AS "Currency_ID", "Tax_Amount" AS "Tax_Amount", "Special_Requests" AS "Special_Requests", "Cancellation_Reason" AS "Cancellation_Reason", "Cancelled_By" AS "Cancelled_By", "Cancelled_Date" AS "Cancelled_Date" FROM iv_customer_resort_bookings_details GROUP BY resort_id, resort_name, room_type, createddate, createddate, "Booking_Status", "ModifiedDate", "ModifiedBy", "Currency_ID", "Tax_Amount", "Special_Requests", "Cancellation_Reason", "Cancelled_By", "Cancelled_Date";

ALTER VIEW iv_room_category_revenue
 LAYOUT (iv_customer_resort_bookings_details = [20, 20, 200, 200]);

