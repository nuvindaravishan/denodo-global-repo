CREATE OR REPLACE VIEW iv_booking_union FOLDER = '/2 - integration' DESCRIPTION = 'The iv_booking_union view provides a detailed and structured representation of booking-related data in the system. It includes key information such as booking ID, resort ID, booking date, type of booking, and identifiers for tour operators, contracts, and customers. Reservation details are meticulously captured, including arrival and departure dates and times, the number of people involved in the booking, the reservation''s duration, and check-in and check-out status. Financial parameters such as room fare, pre-discount amount, discount percentage, and final payment amount are specified. Additionally, timestamps marking the creation of booking records and identifiers for related customer enquiries enrich the dataset.  

This view is essential for managing, analyzing, and reporting booking records, making it a valuable tool in a resort or hospitality system. It facilitates tracking customer reservations, monitoring financial metrics, and understanding booking trends over time. Operationally, the iv_booking_union view can support room assignments, invoice generation, and the identification of customer preferences, thereby enhancing overall efficiency and decision-making within the organization.'  (
    booking_id (description = 'Represents a unique identifier for each booking record in the system.'),
    resort_id (description = 'Denotes the identifier of the resort associated with the booking.'),
    booking_date (description = 'Indicates the date and time when the booking was created in the system.'),
    booking_type_id (description = 'Refers to the type or category of the booking.'),
    tour_operator_id (description = 'Specifies the unique identifier of the tour operator associated with the booking.'),
    tour_operator_contract_id (description = 'Captures the identifier of the contract between the tour operator and the resort for the booking.'),
    customer_id (description = 'Identifies the customer who made the booking.'),
    arrival_date (description = 'Specifies the date on which the customer is expected to arrive at the resort.') TAGS (arrival_details),
    arrival_time (description = 'Indicates the time when the customer is expected to arrive at the resort.'),
    no_of_pax (description = 'Represents the number of people included in the booking.') TAGS (reservation_details),
    reservation_start_date (description = 'Denotes the start date of the reservation period for the booking.'),
    reservation_end_date (description = 'Denotes the end date of the reservation period for the booking.'),
    no_of_days (description = 'Specifies the total number of days for which the reservation is made.'),
    is_checked_in (description = 'Indicates whether the customer has checked into the resort.'),
    room_master_id (description = 'Refers to the identifier of the room assigned for the booking.'),
    room_fare (description = 'Represents the cost of the room per booking.'),
    amount_before_discount (description = 'Captures the total amount for the booking before any discounts are applied.'),
    percentagediscount (description = 'Specifies the discount percentage applied to the booking.'),
    final_amount (description = 'Indicates the total amount to be paid after applying discounts.'),
    departure_date (description = 'Specifies the date on which the customer is expected to check out from the resort.'),
    departure_time (description = 'Specifies the time when the customer is expected to check out from the resort.'),
    is_checked_out (description = 'Indicates whether the customer has checked out of the resort. It includes values like "1", "1", "1", and "1".'),
    customer_enquiry_id (description = 'Refers to the identifier of the customer enquiry related to the booking.'),
    createddate (description = 'Represents the timestamp when the booking record was created in the system.')
 )
 AS SELECT booking_id AS booking_id, resort_id AS resort_id, booking_date AS booking_date, booking_type_id AS booking_type_id, tour_operator_id AS tour_operator_id, tour_operator_contract_id AS tour_operator_contract_id, customer_id AS customer_id, arrival_date AS arrival_date, arrival_time AS arrival_time, no_of_pax AS no_of_pax, reservation_start_date AS reservation_start_date, reservation_end_date AS reservation_end_date, no_of_days AS no_of_days, is_checked_in AS is_checked_in, room_master_id AS room_master_id, room_fare AS room_fare, amount_before_discount AS amount_before_discount, percentagediscount AS percentagediscount, final_amount AS final_amount, departure_date AS departure_date, departure_time AS departure_time, is_checked_out AS is_checked_out, customer_enquiry_id AS customer_enquiry_id, createddate AS createddate, "Booking_Status" AS "Booking_Status", "ModifiedDate" AS "ModifiedDate", "ModifiedBy" AS "ModifiedBy", "Currency_ID" AS "Currency_ID", "Tax_Amount" AS "Tax_Amount", "Special_Requests" AS "Special_Requests", "Cancellation_Reason" AS "Cancellation_Reason", "Cancelled_By" AS "Cancelled_By", "Cancelled_Date" AS "Cancelled_Date", "Booking_Status" AS "Booking_Status_2", "ModifiedDate" AS "ModifiedDate_2", "ModifiedBy" AS "ModifiedBy_2", "Currency_ID" AS "Currency_ID_2", "Tax_Amount" AS "Tax_Amount_2", "Special_Requests" AS "Special_Requests_2", "Cancellation_Reason" AS "Cancellation_Reason_2", "Cancelled_By" AS "Cancelled_By_2", "Cancelled_Date" AS "Cancelled_Date_2" FROM (SELECT booking_id, resort_id, booking_date, booking_type_id, tour_operator_id, tour_operator_contract_id, customer_id, arrival_date, arrival_time, no_of_pax, reservation_start_date, reservation_end_date, no_of_days, is_checked_in, room_master_id, room_fare, amount_before_discount, percentagediscount, final_amount, departure_date, departure_time, is_checked_out, customer_enquiry_id, createddate, "Booking_Status" AS "Booking_Status", "ModifiedDate" AS "ModifiedDate", "ModifiedBy" AS "ModifiedBy", "Currency_ID" AS "Currency_ID", "Tax_Amount" AS "Tax_Amount", "Special_Requests" AS "Special_Requests", "Cancellation_Reason" AS "Cancellation_Reason", "Cancelled_By" AS "Cancelled_By", "Cancelled_Date" AS "Cancelled_Date", "Booking_Status" AS "Booking_Status_2", "ModifiedDate" AS "ModifiedDate_2", "ModifiedBy" AS "ModifiedBy_2", "Currency_ID" AS "Currency_ID_2", "Tax_Amount" AS "Tax_Amount_2", "Special_Requests" AS "Special_Requests_2", "Cancellation_Reason" AS "Cancellation_Reason_2", "Cancelled_By" AS "Cancelled_By_2", "Cancelled_Date" AS "Cancelled_Date_2" FROM iv_booking_history SQL UNION ALL SELECT booking_id, resort_id, booking_date, booking_type_id, tour_operator_id, tour_operator_contract_id, customer_id, arrival_date, arrival_time, no_of_pax, reservation_start_date, reservation_end_date, no_of_days, is_checked_in, room_master_id, room_fare, amount_before_discount, percentagediscount, final_amount, departure_date, departure_time, is_checked_out, customer_enquiry_id, createddate, "Booking_Status" AS "Booking_Status", "ModifiedDate" AS "ModifiedDate", "ModifiedBy" AS "ModifiedBy", "Currency_ID" AS "Currency_ID", "Tax_Amount" AS "Tax_Amount", "Special_Requests" AS "Special_Requests", "Cancellation_Reason" AS "Cancellation_Reason", "Cancelled_By" AS "Cancelled_By", "Cancelled_Date" AS "Cancelled_Date", "Booking_Status" AS "Booking_Status_2", "ModifiedDate" AS "ModifiedDate_2", "ModifiedBy" AS "ModifiedBy_2", "Currency_ID" AS "Currency_ID_2", "Tax_Amount" AS "Tax_Amount_2", "Special_Requests" AS "Special_Requests_2", "Cancellation_Reason" AS "Cancellation_Reason_2", "Cancelled_By" AS "Cancelled_By_2", "Cancelled_Date" AS "Cancelled_Date_2" FROM iv_booking_current) ORDER BY customer_id ASC;

ALTER VIEW iv_booking_union
 LAYOUT (iv_booking_history = [20, 20, 200, 200], iv_booking_current = [325, 24, 200, 200]);

