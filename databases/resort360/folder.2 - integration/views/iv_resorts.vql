CREATE OR REPLACE VIEW iv_resorts FOLDER = '/2 - integration' DESCRIPTION = 'The iv_resorts view represents a collection of resorts. It includes information such as the names of each resort, providing clarity and identity within the list of accommodations. Examples of resort names include "Pinewood Resort," "Mountain Valley Lodge," "Crystal Lake Resort," and "Redwood Haven." The view does not have additional descriptive details or direct associations to other views.'  (
    resort_name TAGS (resort)
 )
 AS SELECT DISTINCT bv_resorts.resort_name AS resort_name FROM bv_resorts;

ALTER VIEW iv_resorts
 LAYOUT (bv_resorts = [20, 20, 200, 200]);

