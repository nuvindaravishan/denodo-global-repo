CREATE OR REPLACE VIEW iv_booking_date_join FOLDER = '/2 - integration' DESCRIPTION = 'The "iv_booking_date_join" view provides detailed data related to bookings and their associated dates, encompassing fields such as resort identifiers, booking IDs, customer IDs, reservation details, the number of people per booking, and financial specifics like daily booking amounts. Additionally, it offers calendar-related attributes, including specific date properties, year, quarter, month, day, weekday names, and weekend identification. This view is structured with diverse data types, including timestamps, integers, decimals, text, and booleans. It could be utilized for analyzing booking trends over time, offering insights into customer behaviors, financial performance, and resource utilization. Moreover, it supports date-based reporting and aggregation to facilitate operational decision-making, such as identifying peak booking periods, evaluating weekday versus weekend bookings, and understanding seasonal demand patterns in the hospitality industry.'  (
    booking_date TAGS (booking_date),
    reservation_start_date TAGS (reservation_details),
    reservation_end_date TAGS (reservation_details),
    booking_type TAGS (booking_category)
 )
 AS SELECT bv_booking.resort_id AS resort_id, bv_booking.booking_id AS booking_id, bv_booking.booking_date AS booking_date, bv_booking.customer_id AS customer_id, bv_booking.no_of_pax AS no_of_pax, bv_booking.reservation_start_date AS reservation_start_date, bv_booking.reservation_end_date AS reservation_end_date, bv_booking.no_of_days AS no_of_days, (bv_booking.final_amount/bv_booking.no_of_days) AS amount_per_day, bv_date.date AS date, bv_booking.room_master_id AS room_master_id, bv_booking.booking_type_id AS booking_type, bv_date.datekey AS datekey, bv_date.year AS year, bv_date.quarter AS quarter, bv_date.month AS month, bv_date.monthname AS monthname, bv_date.day AS day, bv_date.weekdayname AS weekdayname, bv_date.isweekend AS isweekend, bv_booking."Booking_Status" AS "Booking_Status", bv_booking."ModifiedDate" AS "ModifiedDate", bv_booking."ModifiedBy" AS "ModifiedBy", bv_booking."Currency_ID" AS "Currency_ID", bv_booking."Tax_Amount" AS "Tax_Amount", bv_booking."Special_Requests" AS "Special_Requests", bv_booking."Cancellation_Reason" AS "Cancellation_Reason", bv_booking."Cancelled_By" AS "Cancelled_By", bv_booking."Cancelled_Date" AS "Cancelled_Date" FROM bv_booking AS bv_booking LEFT OUTER JOIN bv_date AS bv_date ON (bv_date.date >= bv_booking.reservation_start_date AND bv_date.date < bv_booking.reservation_end_date) ;

ALTER VIEW iv_booking_date_join
 LAYOUT (bv_booking = [20, 20, 200, 200], bv_date = [585, 4, 200, 200]);

