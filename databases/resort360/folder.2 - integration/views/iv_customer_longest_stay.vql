CREATE OR REPLACE VIEW iv_customer_longest_stay FOLDER = '/2 - integration'
    TAGS (booking, customer_domain) (
    booking_date TAGS (booking_date),
    resort_name TAGS (resort),
    customer_name TAGS (customer_domain)
 )
 AS SELECT iv_customer_resort_bookings_details.booking_id AS booking_id, iv_customer_resort_bookings_details.booking_date AS booking_date, iv_customer_resort_bookings_details.resort_name AS resort_name, iv_customer_resort_bookings_details.customer_name AS customer_name, iv_customer_resort_bookings_details.no_of_days AS no_of_days, createddate AS createddate, "Booking_Status" AS "Booking_Status", "ModifiedDate" AS "ModifiedDate", "ModifiedBy" AS "ModifiedBy", "Currency_ID" AS "Currency_ID", "Tax_Amount" AS "Tax_Amount", "Special_Requests" AS "Special_Requests", "Cancellation_Reason" AS "Cancellation_Reason", "Cancelled_By" AS "Cancelled_By", "Cancelled_Date" AS "Cancelled_Date" FROM iv_customer_resort_bookings_details ORDER BY no_of_days DESC;

ALTER VIEW iv_customer_longest_stay
 LAYOUT (iv_customer_resort_bookings_details = [20, 20, 200, 200]);

