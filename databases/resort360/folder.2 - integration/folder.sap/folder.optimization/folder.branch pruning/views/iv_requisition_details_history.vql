CREATE OR REPLACE VIEW iv_requisition_details_history FOLDER = '/2 - integration/sap/optimization/branch pruning' DESCRIPTION = 'The iv_requisition_details_history view contains historical data related to item requisitions. It includes information such as unique identifiers for requisition records, resort names, supplier names, request dates, financial details (including subtotal, discount, shipping charges, and total amount), requisition statuses, and shipping addresses. This view provides structured details that could be useful for tracking and analyzing historical requisition data, including financial transactions, supplier interactions, and delivery details. It can also support reporting and decision-making processes related to requisitions, such as reviewing past trends, identifying suppliers, assessing costs, or monitoring statuses of item requisitions.' 
    TAGS (address, requisition_date, resort, supplier) (
    resort_name TAGS (resort),
    supplier_name TAGS (supplier),
    request_date TAGS (requisition_date),
    shipping_address TAGS (address)
 )
 AS SELECT iv_item_requisition_sap.ir_id AS ir_id, bv_resorts.resort_name AS resort_name, bv_supplier.supplier_name AS supplier_name, iv_item_requisition_sap.request_date AS request_date, iv_item_requisition_sap.irsubtotal AS irsubtotal, iv_item_requisition_sap.discount AS discount, iv_item_requisition_sap.shippingcharge AS shippingcharge, iv_item_requisition_sap.irtotal AS irtotal, iv_item_requisition_sap.ir_status AS ir_status, iv_item_requisition_sap.shipping_address AS shipping_address FROM bv_resorts AS bv_resorts INNER JOIN (iv_item_requisition_sap AS iv_item_requisition_sap INNER JOIN bv_supplier AS bv_supplier ON iv_item_requisition_sap.supplier_id = bv_supplier.supplier_id ) ON bv_resorts.resort_id = iv_item_requisition_sap.resort_id  WHERE (iv_item_requisition_sap.request_date >= '2023-01-01' AND iv_item_requisition_sap.request_date <= '2025-12-31');

ALTER VIEW iv_requisition_details_history
 LAYOUT (bv_resorts = [29, 49, 200, 200], iv_item_requisition_sap = [343, 58, 200, 200], bv_supplier = [774, 66, 200, 200]);

