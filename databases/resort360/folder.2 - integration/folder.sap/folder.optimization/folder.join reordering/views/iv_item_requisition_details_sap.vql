CREATE OR REPLACE VIEW iv_item_requisition_details_sap FOLDER = '/2 - integration/sap/optimization/join reordering' DESCRIPTION = 'The view iv_item_requisition_details_sap contains detailed information concerning item requisition entries. It includes fields such as ir_detail_id, resort_id, ir_id, item_id, quantity, rate, total, discount, tax, itemtotal, is_approved, po_order_quantity, createddate, and item_name. Each field captures critical data points, such as item identifiers, requisition details, item quantities, rates, costs, approval status, and timestamps. The schema allows for a comprehensive representation of item requisition details and tracks relevant financial and operational metrics. This view could be used for managing and tracking item requisitions in a structured and detailed manner. It provides valuable insights into requisition details, costs, quantities, and approval statuses, supporting inventory management, procurement processes, and budget control.' 
    PRIMARY KEY ( 'item_id' ) (
    resort_id TAGS (resort),
    quantity TAGS (item_quantity)
 )
 AS SELECT bv_item_requisition_details.ir_detail_id AS ir_detail_id, bv_item_requisition_details.resort_id AS resort_id, bv_item_requisition_details.ir_id AS ir_id, bv_item_requisition_details.item_id AS item_id, bv_item_requisition_details.quantity AS quantity, bv_item_requisition_details.rate AS rate, bv_item_requisition_details.total AS total, bv_item_requisition_details_sap.discount AS discount, bv_item_requisition_details_sap.tax AS tax, bv_item_requisition_details_sap.itemtotal AS itemtotal, bv_item_requisition_details.is_approved AS is_approved, bv_item_requisition_details.po_order_quantity AS po_order_quantity, bv_item_requisition_details.createddate AS createddate, bv_product.item_name AS item_name FROM (bv_item_requisition_details AS bv_item_requisition_details INNER JOIN bv_item_requisition_details_sap AS bv_item_requisition_details_sap ON bv_item_requisition_details.ir_detail_id = bv_item_requisition_details_sap.irdetailid ) INNER JOIN bv_product AS bv_product ON bv_item_requisition_details.item_id = bv_product.item_id ;

ALTER VIEW iv_item_requisition_details_sap
 LAYOUT (bv_item_requisition_details = [31, 31, 200, 200], bv_item_requisition_details_sap = [302, 32, 200, 200], bv_product = [281, 223, 200, 200]);

