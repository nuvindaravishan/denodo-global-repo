CREATE OR REPLACE VIEW iv_item_requisition_sap FOLDER = '/2 - integration/sap' DESCRIPTION = 'The iv_item_requisition_sap view represents detailed information about item requisition records, including unique identifiers for requisitions, resorts, suppliers, and quotations. It also encompasses details such as the status, priority, request date, shipping address, and financial specifics like subtotal, discounts, shipping charges, and total amounts. Additionally, it includes metadata like created timestamps, as well as year and month references for easier categorization and analysis. This view could be used to manage, track, and analyze item requisition records. It provides essential data that can help in tracking the lifecycle of requisitions, understanding financial aspects like costs and discounts, prioritizing high-priority requisitions, coordinating supplier associations, and organizing data by time periods for reporting and decision-making purposes.'  (
    resort_id TAGS (resort),
    request_date TAGS (requisition_date),
    supplier_id TAGS (supplier),
    shipping_address TAGS (address)
 )
 AS SELECT bv_item_requisition.ir_id AS ir_id, bv_item_requisition.resort_id AS resort_id, bv_item_requisition.ir_no AS ir_no, to_localdate('yyyy-mm-dd', bv_item_requisition.request_date) AS request_date, bv_item_requisition.ir_status AS ir_status, bv_item_requisition.priority AS priority, bv_item_requisition.supplier_id AS supplier_id, bv_item_requisition.quote_ref AS quote_ref, bv_item_requisition.shipping_address AS shipping_address, bv_item_requisition.createddate AS createddate, bv_item_requisition_sap.irsubtotal AS irsubtotal, bv_item_requisition_sap.discount AS discount, bv_item_requisition_sap.shippingcharge AS shippingcharge, bv_item_requisition_sap.irtotal AS irtotal, getyear(bv_item_requisition.request_date) AS year, case WHEN (getmonth(bv_item_requisition.request_date) = 1) THEN 'January' WHEN (getmonth(bv_item_requisition.request_date) = 2) THEN 'February' WHEN (getmonth(bv_item_requisition.request_date) = 3) THEN 'March' WHEN (getmonth(bv_item_requisition.request_date) = 4) THEN 'April' WHEN (getmonth(bv_item_requisition.request_date) = 5) THEN 'May' WHEN (getmonth(bv_item_requisition.request_date) = 6) THEN 'June' WHEN (getmonth(bv_item_requisition.request_date) = 7) THEN 'July' WHEN (getmonth(bv_item_requisition.request_date) = 8) THEN 'August' WHEN (getmonth(bv_item_requisition.request_date) = 9) THEN 'September' WHEN (getmonth(bv_item_requisition.request_date) = 10) THEN 'October' WHEN (getmonth(bv_item_requisition.request_date) = 11) THEN 'November' WHEN (getmonth(bv_item_requisition.request_date) = 12) THEN 'December' END AS month, bv_item_requisition_sap.quotationno AS quotation_no FROM bv_item_requisition AS bv_item_requisition HASH INNER JOIN bv_item_requisition_sap AS bv_item_requisition_sap ON bv_item_requisition.ir_id = bv_item_requisition_sap.irid ;

ALTER VIEW iv_item_requisition_sap
 LAYOUT (bv_item_requisition = [20, 20, 200, 200], bv_item_requisition_sap = [295, 22, 200, 200]);

