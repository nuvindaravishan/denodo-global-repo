CREATE OR REPLACE VIEW dq_data_product_scorecard AS SELECT 'CUSTOMER_INTELLIGENCE' AS product_name, cast("Customer Identifier" AS TEXT) AS record_id, case WHEN ("Customer Identifier" is not null ) THEN true ELSE false END AS dq_customer_id_complete, case WHEN ("Full Customer Name" is not null ) THEN true ELSE false END AS dq_customer_name_complete, case WHEN (("Total bookings" is not null  AND "Total bookings" >= 0)) THEN true ELSE false END AS dq_total_bookings_valid, case WHEN (("Estimated customer value" is not null  AND "Estimated customer value" >= 0)) THEN true ELSE false END AS dq_customer_value_valid, case WHEN (("Customer Identifier" is not null  AND "Full Customer Name" is not null  AND "Total bookings" is not null  AND "Total bookings" >= 0 AND "Estimated customer value" is not null  AND "Estimated customer value" >= 0)) THEN true ELSE false END AS dq_record_valid, (((case WHEN ("Customer Identifier" is not null ) THEN 25 ELSE 0 END+case WHEN ("Full Customer Name" is not null ) THEN 25 ELSE 0 END)+case WHEN (("Total bookings" is not null  AND "Total bookings" >= 0)) THEN 25 ELSE 0 END)+case WHEN (("Estimated customer value" is not null  AND "Estimated customer value" >= 0)) THEN 25 ELSE 0 END) AS dq_quality_score FROM dp_customer_intelligence SQL UNION ALL SELECT 'BOOKING_DEMAND' AS product_name, "Resort Name" AS record_id, case WHEN ("Resort Name" is not null ) THEN true ELSE false END AS dq_customer_id_complete, case WHEN ("Resort Name" is not null ) THEN true ELSE false END AS dq_customer_name_complete, case WHEN (("Total bookings" is not null  AND "Total bookings" >= 0)) THEN true ELSE false END AS dq_total_bookings_valid, case WHEN (("Booking confirmation rate" is not null  AND "Booking confirmation rate" >= 0 AND "Booking confirmation rate" <= 1)) THEN true ELSE false END AS dq_customer_value_valid, case WHEN (("Resort Name" is not null  AND "Total bookings" is not null  AND "Total bookings" >= 0 AND "Booking confirmation rate" is not null  AND "Booking confirmation rate" >= 0 AND "Booking confirmation rate" <= 1 AND "Denied demand rate" is not null  AND "Denied demand rate" >= 0 AND "Denied demand rate" <= 1)) THEN true ELSE false END AS dq_record_valid, (((case WHEN ("Resort Name" is not null ) THEN 25 ELSE 0 END+case WHEN (("Total bookings" is not null  AND "Total bookings" >= 0)) THEN 25 ELSE 0 END)+case WHEN (("Booking confirmation rate" is not null  AND "Booking confirmation rate" >= 0 AND "Booking confirmation rate" <= 1)) THEN 25 ELSE 0 END)+case WHEN (("Denied demand rate" is not null  AND "Denied demand rate" >= 0 AND "Denied demand rate" <= 1)) THEN 25 ELSE 0 END) AS dq_quality_score FROM dp_booking_demand;

