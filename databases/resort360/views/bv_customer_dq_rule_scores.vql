CREATE OR REPLACE VIEW bv_customer_dq_rule_scores AS SELECT 'gender_domain_check' AS rule_name, count(*) AS total_records, sum(gender_valid) AS passed_records, round(((sum(gender_valid)*100.0)/count(*)), 2) AS dq_score_pct FROM bv_customer_dq_checks SQL UNION ALL SELECT 'mobile_pattern_check' AS rule_name, count(*) AS total_records, sum(mobile_valid) AS passed_records, round(((sum(mobile_valid)*100.0)/count(*)), 2) AS dq_score_pct FROM bv_customer_dq_checks SQL UNION ALL SELECT 'passportno_pattern_check' AS rule_name, count(*) AS total_records, sum(passportno_valid) AS passed_records, round(((sum(passportno_valid)*100.0)/count(*)), 2) AS dq_score_pct FROM bv_customer_dq_checks;

