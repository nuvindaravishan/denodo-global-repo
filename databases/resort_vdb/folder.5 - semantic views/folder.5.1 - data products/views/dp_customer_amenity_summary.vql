CREATE OR REPLACE VIEW dp_customer_amenity_summary FOLDER = '/5 - semantic views/5.1 - data products' AS SELECT customer_id AS customer_id, customer_name AS customer_name, resort_name AS resort_name, amenity_name AS amenity_name, amenity_category AS amenity_category, count(amenity_booking_id) AS amenity_usage_count, round(sum(amenity_amount), 2) AS total_amenity_revenue, sum(no_of_hours) AS total_amenity_hours, round(avg(amenity_amount), 2) AS avg_amenity_spend, min(amenity_booking_date) AS first_amenity_booking_date, max(amenity_booking_date) AS last_amenity_booking_date FROM iv_customer_amenity_360 GROUP BY customer_id, customer_name, resort_name, amenity_name, amenity_category;

