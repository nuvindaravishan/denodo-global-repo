CREATE OR REPLACE VIEW dp_customer_booking_summary FOLDER = '/5 - semantic views/5.1 - data products' AS SELECT customer_id AS customer_id, customer_name AS customer_name, nationality AS nationality, resort_name AS resort_name, count(DISTINCT booking_id) AS booking_count, round(sum(final_amount), 2) AS total_booking_revenue, round(sum(paid_amount), 2) AS total_paid_amount, round(sum(balance_amount), 2) AS outstanding_balance, round(avg(stay_days), 2) AS avg_stay_days, sum(guest_count) AS total_guests, min(booking_date) AS first_booking_date, max(booking_date) AS last_booking_date FROM iv_customer_booking_360 GROUP BY customer_id, customer_name, nationality, resort_name;

