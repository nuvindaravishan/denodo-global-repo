CREATE OR REPLACE VIEW iv_customer_amenity_360 FOLDER = '/4 - integration views' AS SELECT cab."Customer_Amenities_Booking_ID" AS amenity_booking_id, cab."Customer_ID" AS customer_id, ((c."First_Name"||' ')||c."Last_Name") AS customer_name, cab."Booking_ID" AS booking_id, cab."Resort_ID" AS resort_id, r."Resort_Name" AS resort_name, cab."Amenities_ID" AS amenity_id, a."Amenity_Name" AS amenity_name, a."Category" AS amenity_category, cab."Booking_Date" AS amenity_booking_date, cab."No_of_Hours" AS no_of_hours, round(cab."Amount", 2) AS amenity_amount, cab."Status" AS amenity_status FROM ((bv_customer_amenities_booking AS cab INNER JOIN bv_amenities AS a ON cab."Amenities_ID" = a."Amenity_ID" ) INNER JOIN bv_customer AS c ON cab."Customer_ID" = c."Customer_ID" ) INNER JOIN bv_resorts AS r ON cab."Resort_ID" = r."Resort_ID" ;

