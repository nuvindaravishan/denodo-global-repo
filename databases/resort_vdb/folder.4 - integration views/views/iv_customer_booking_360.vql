CREATE OR REPLACE VIEW iv_customer_booking_360 FOLDER = '/4 - integration views' AS SELECT b."Booking_ID" AS booking_id, b."Customer_ID" AS customer_id, ((c."First_Name"||' ')||c."Last_Name") AS customer_name, c."Nationality" AS nationality, b."Resort_ID" AS resort_id, r."Resort_Name" AS resort_name, r."City" AS resort_city, b."Booking_Date" AS booking_date, b."Arrival_Date" AS arrival_date, b."Reservation_Start_Date" AS reservation_start_date, b."Reservation_End_Date" AS reservation_end_date, b."No_Of_Days" AS stay_days, b."No_of_Pax" AS guest_count, b."Booking_Status" AS booking_status, bt."Booking_Type_Description" AS booking_type, b."Room_Master_ID" AS room_master_id, rm."Room_Category" AS room_category, rc."Room_Type" AS room_type, rc."Capacity" AS room_capacity, round(b."Final_Amount", 2) AS final_amount, round(p."Paid", 2) AS paid_amount, round(p."Balance", 2) AS balance_amount, p."Payment_Status" AS payment_status, p."Mode_Of_Payment" AS mode_of_payment FROM (((((bv_booking AS b INNER JOIN bv_customer AS c ON b."Customer_ID" = c."Customer_ID" ) INNER JOIN bv_resorts AS r ON b."Resort_ID" = r."Resort_ID" ) LEFT OUTER JOIN bv_room_master AS rm ON b."Room_Master_ID" = rm."Room_Master_ID" ) LEFT OUTER JOIN bv_room_category AS rc ON rm."Room_Category_ID" = rc."Room_Category_ID" ) LEFT OUTER JOIN bv_booking_type AS bt ON b."Booking_Type_ID" = bt."Booking_Type_ID" ) LEFT OUTER JOIN bv_payment AS p ON b."Booking_ID" = p."Booking_Id" ;

